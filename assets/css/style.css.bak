/* ==========================================================================
   CSS VARIABLES & DESIGN TOKENS
   ========================================================================== */
:root {
  /* Colors - Light Theme (Default) */
  --color-primary: #0A192F; /* Deep Slate Navy */
  --color-primary-light: #172A45;
  --color-secondary: #F8F9FA; /* Soft Gray/Off-White */
  --color-secondary-dark: #E9ECEF;
  --color-accent: #C5A880; /* Champagne Gold */
  --color-accent-hover: #D4BA96;
  
  --color-bg: #FFFFFF;
  --color-bg-alt: #F8F9FA;
  --color-text: #333333;
  --color-text-muted: #666666;
  --color-text-inverse: #FFFFFF;
  --color-border: #E0E0E0;
  
  --color-error: #DC3545;
  --color-success: #28A745;
  
  /* Typography */
  --font-heading: 'Playfair Display', serif;
  --font-body: 'Lato', sans-serif;
  
  --fw-body: 400;
  --fw-h1: 580;
  --fw-h2: 540;
  --fw-h3: 520;
  
  /* Spacing */
  --spacing-1: 0.25rem; /* 4px */
  --spacing-2: 0.5rem;  /* 8px */
  --spacing-3: 1rem;    /* 16px */
  --spacing-4: 1.5rem;  /* 24px */
  --spacing-5: 2rem;    /* 32px */
  --spacing-6: 3rem;    /* 48px */
  --spacing-8: 4rem;    /* 64px */
  --spacing-10: 6rem;   /* 96px */
  
  /* Layout */
  --radius: 4px;
  --shadow: 0 4px 12px rgba(10, 25, 47, 0.08);
  --shadow-hover: 0 8px 24px rgba(10, 25, 47, 0.12);
  --transition: all 0.3s ease;
  --nav-height: 80px;
  --container-width: 1200px;
}

/* Dark Mode Overrides */
[data-theme="dark"] {
  --color-bg: #0B1120;
  --color-bg-alt: #111827;
  --color-text: #F3F4F6;
  --color-text-muted: #9CA3AF;
  --color-text-inverse: #FFFFFF;
  --color-border: #1F2937;
  --color-secondary: #1F2937;
  --color-secondary-dark: #374151;
  --color-primary: #FFFFFF;
  --color-primary-light: #F3F4F6;
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
  --shadow-hover: 0 8px 24px rgba(0, 0, 0, 0.4);
}

/* ==========================================================================
   RESET & GLOBAL STYLES
   ========================================================================== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-body);
  font-weight: var(--fw-body);
  color: var(--color-text);
  background-color: var(--color-bg);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  transition: background-color 0.3s ease, color 0.3s ease;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
  transition: var(--transition);
}

ul {
  list-style: none;
}

/* Typography Base */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  line-height: 1.2;
  margin-bottom: var(--spacing-3);
  color: var(--color-primary);
}

[data-theme="dark"] h1, 
[data-theme="dark"] h2, 
[data-theme="dark"] h3, 
[data-theme="dark"] h4, 
[data-theme="dark"] h5, 
[data-theme="dark"] h6 {
  color: var(--color-primary);
}

h1 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: var(--fw-h1);
  letter-spacing: -0.02em;
}

h2 {
  font-size: clamp(2rem, 4vw, 2.75rem);
  font-weight: var(--fw-h2);
  letter-spacing: -0.01em;
}

h3 {
  font-size: clamp(1.25rem, 2.5vw, 1.5rem);
  font-weight: var(--fw-h3);
}

p {
  margin-bottom: var(--spacing-3);
}

/* Layout Utilities */
.container {
  max-width: var(--container-width);
  margin: 0 auto;
  padding: 0 var(--spacing-4);
  width: 100%;
}

.section {
  padding: var(--spacing-10) 0;
  scroll-margin-top: var(--nav-height);
}

.bg-alt {
  background-color: var(--color-bg-alt);
}

.text-center {
  text-align: center;
}

.section-header {
  margin-bottom: var(--spacing-8);
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
}

.section-header p {
  color: var(--color-text-muted);
  font-size: 1.125rem;
}

.grid {
  display: grid;
  gap: var(--spacing-5);
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.5rem;
  border-radius: var(--radius);
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 1rem;
  cursor: pointer;
  transition: var(--transition);
  border: 1px solid transparent;
  gap: var(--spacing-2);
}

.btn-primary {
  background-color: var(--color-accent);
  color: #FFFFFF; /* Always white text on gold button */
}
[data-theme="dark"] .btn-primary { color: #111827; }

.btn-primary:hover {
  background-color: var(--color-accent-hover);
  transform: translateY(-2px);
}

.btn-outline {
  background-color: transparent;
  border-color: var(--color-border);
  color: var(--color-text);
}

.btn-outline:hover {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.btn-text {
  background: none;
  padding: 0;
  color: var(--color-accent);
  font-weight: 700;
}
.btn-text:hover {
  color: var(--color-accent-hover);
  gap: var(--spacing-3); /* expands gap slightly on hover */
}

.btn-lg {
  padding: 1rem 2rem;
  font-size: 1.125rem;
}

.btn-full {
  width: 100%;
}

/* ==========================================================================
   NAVIGATION
   ========================================================================== */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: var(--nav-height);
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  z-index: 1000;
  border-bottom: 1px solid var(--color-border);
  transition: var(--transition);
}

[data-theme="dark"] .navbar {
  background-color: rgba(11, 17, 32, 0.9);
}

.nav-container {
  max-width: var(--container-width);
  margin: 0 auto;
  padding: 0 var(--spacing-4);
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo-link {
  display: flex;
  align-items: center;
  gap: var(--spacing-2);
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: var(--fw-h2);
  color: var(--color-primary);
}

.logo-link i {
  color: var(--color-accent);
  font-size: 1.75rem;
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: var(--spacing-5);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: var(--spacing-4);
}

.nav-link {
  font-weight: 700;
  color: var(--color-text-muted);
  font-size: 0.9375rem;
  position: relative;
}

.nav-link:hover, .nav-link.active {
  color: var(--color-accent);
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 0;
  height: 2px;
  background-color: var(--color-accent);
  transition: var(--transition);
}

.nav-link.active::after {
  width: 100%;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-3);
}

.theme-toggle {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 1.25rem;
  color: var(--color-text);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  transition: var(--transition);
}

.theme-toggle:hover {
  background-color: var(--color-bg-alt);
}

[data-theme="dark"] .theme-icon-moon { display: none; }
[data-theme="light"] .theme-icon-sun { display: none; }

.hamburger {
  display: none;
  background: none;
  border: none;
  font-size: 1.75rem;
  color: var(--color-text);
  cursor: pointer;
}

.drawer-close {
  display: none;
  background: none;
  border: none;
  font-size: 1.5rem;
  color: var(--color-text);
  position: absolute;
  top: var(--spacing-4);
  right: var(--spacing-4);
  cursor: pointer;
}

.nav-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transition: var(--transition);
  z-index: 999;
}

/* ==========================================================================
   HERO SECTION
   ========================================================================== */
.hero {
  padding-top: calc(var(--spacing-10) + var(--nav-height));
  position: relative;
  overflow: hidden;
}

.hero-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-6);
  align-items: center;
}

.hero-text p {
  font-size: 1.125rem;
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-5);
  max-width: 500px;
}

.hero-actions {
  display: flex;
  gap: var(--spacing-3);
}

.hero-img {
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  width: 100%;
  height: auto;
  object-fit: cover;
  aspect-ratio: 4/3;
}

.trust-strip {
  margin-top: var(--spacing-8);
  border-top: 1px solid var(--color-border);
  padding: var(--spacing-4) 0;
}

.trust-strip-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--spacing-3);
}

.trust-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-2);
  font-weight: 700;
  color: var(--color-text-muted);
  font-size: 0.875rem;
}
.trust-item i {
  color: var(--color-accent);
  font-size: 1.25rem;
}

/* ==========================================================================
   SERVICES SECTION
   ========================================================================== */
.services-grid {
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
}

.card {
  background-color: var(--color-bg);
  border-radius: var(--radius);
  padding: var(--spacing-5);
  box-shadow: var(--shadow);
  transition: var(--transition);
  border: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.card:hover {
  box-shadow: var(--shadow-hover);
  transform: translateY(-4px);
}

.card-icon {
  width: 60px;
  height: 60px;
  background-color: var(--color-secondary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-3);
}

.card-icon i {
  font-size: 1.75rem;
  color: var(--color-accent);
}

.card h3 {
  margin-bottom: var(--spacing-2);
}

.card p {
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-4);
  flex-grow: 1;
}

/* ==========================================================================
   BOOKING & FORMS
   ========================================================================== */
.booking-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-8);
  align-items: center;
}

.secure-notice {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-2);
  color: var(--color-success);
  font-weight: 700;
  font-size: 0.875rem;
  background: rgba(40, 167, 69, 0.1);
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  margin-top: var(--spacing-3);
  margin-bottom: var(--spacing-4);
}

.form {
  background-color: var(--color-bg);
  padding: var(--spacing-5);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  border: 1px solid var(--color-border);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-4);
}

.form-group {
  margin-bottom: var(--spacing-4);
  position: relative;
}

label {
  display: block;
  font-weight: 700;
  margin-bottom: var(--spacing-2);
  font-size: 0.875rem;
}

.req {
  color: var(--color-error);
}

input, select, textarea {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-body);
  font-size: 1rem;
  transition: var(--transition);
}

input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(197, 168, 128, 0.2);
}

.select-wrapper {
  position: relative;
}

select {
  appearance: none;
  padding-right: 2.5rem;
}

.select-icon {
  position: absolute;
  right: 1rem;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  color: var(--color-text-muted);
}

.checkbox-group {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-2);
}

.checkbox-group input {
  width: auto;
  margin-top: 4px;
}

.checkbox-group label {
  margin-bottom: 0;
  font-weight: 400;
}

.error-msg {
  display: none;
  color: var(--color-error);
  font-size: 0.75rem;
  margin-top: var(--spacing-1);
}

.form-group.error input,
.form-group.error select,
.form-group.error textarea {
  border-color: var(--color-error);
}
.form-group.error .error-msg {
  display: block;
}

.form-group.success input,
.form-group.success select,
.form-group.success textarea {
  border-color: var(--color-success);
}

.form-success-msg {
  display: none;
  background-color: rgba(40, 167, 69, 0.1);
  color: var(--color-success);
  padding: var(--spacing-3);
  border-radius: var(--radius);
  margin-top: var(--spacing-4);
  font-weight: 700;
  text-align: center;
}
.form.submitted .form-success-msg {
  display: block;
}
.form.submitted button[type="submit"] {
  display: none;
}

/* ==========================================================================
   RESOURCES
   ========================================================================== */
.resources-grid {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: var(--spacing-6);
}

.calc-card {
  align-items: flex-start;
  text-align: left;
}
.calc-card h3 { display: flex; align-items: center; gap: var(--spacing-2); }
.small-text { font-size: 0.875rem; }

.calc-result {
  margin-top: var(--spacing-4);
  padding-top: var(--spacing-4);
  border-top: 1px dashed var(--color-border);
  width: 100%;
}
.calc-result.hidden { display: none; }

.result-label {
  font-weight: 700;
  font-size: 0.875rem;
  color: var(--color-text-muted);
}
.result-value {
  font-size: 2rem;
  font-family: var(--font-heading);
  color: var(--color-primary);
  margin-bottom: var(--spacing-2);
}
.disclaimer {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  font-style: italic;
  margin-bottom: 0;
}

.articles-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-4);
}

.article-card {
  padding: var(--spacing-4);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background: var(--color-bg);
  transition: var(--transition);
}
.article-card:hover {
  border-color: var(--color-accent);
}
.article-card h4 { margin-bottom: var(--spacing-2); }
.article-card p { font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: var(--spacing-3); }

.read-more {
  color: var(--color-accent);
  font-weight: 700;
  font-size: 0.875rem;
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-1);
}
.read-more:hover { gap: var(--spacing-2); }

/* ==========================================================================
   ABOUT & TRUST
   ========================================================================== */
.about-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-6);
  align-items: center;
}

.about-image img {
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  aspect-ratio: 4/3;
  object-fit: cover;
}

.credibility-stats {
  display: flex;
  gap: var(--spacing-5);
  margin-top: var(--spacing-5);
  padding-top: var(--spacing-4);
  border-top: 1px solid var(--color-border);
}

.stat-num {
  display: block;
  font-size: 2rem;
  font-family: var(--font-heading);
  color: var(--color-accent);
  line-height: 1;
  margin-bottom: 4px;
}
.stat-label {
  font-size: 0.875rem;
  color: var(--color-text-muted);
  font-weight: 700;
}

.trust-features-grid {
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: var(--spacing-8);
}
.feature-item { text-align: center; }
.feature-icon {
  width: 64px;
  height: 64px;
  margin: 0 auto var(--spacing-3);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
  color: var(--color-accent);
}

.testimonials {
  max-width: 800px;
  margin: 0 auto;
}
.testimonial-card {
  background: var(--color-bg);
  padding: var(--spacing-5);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  border: 1px solid var(--color-border);
}
.stars { color: var(--color-accent); margin-bottom: var(--spacing-3); font-size: 1.25rem; }
.quote { font-size: 1.25rem; font-style: italic; margin-bottom: var(--spacing-4); }
.author strong { display: block; }
.author span { font-size: 0.875rem; color: var(--color-text-muted); }

/* ==========================================================================
   CONTACT
   ========================================================================== */
.contact-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-8);
}
.contact-methods { margin-bottom: var(--spacing-5); }
.method {
  display: flex;
  gap: var(--spacing-3);
  margin-bottom: var(--spacing-4);
}
.method i {
  font-size: 1.5rem;
  color: var(--color-accent);
  margin-top: 4px;
}

.map-placeholder {
  border-radius: var(--radius);
  overflow: hidden;
  border: 1px solid var(--color-border);
}

/* ==========================================================================
   FOOTER
   ========================================================================== */
.footer {
  background-color: var(--color-primary);
  color: #FFFFFF;
  padding: var(--spacing-8) 0 var(--spacing-4);
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: var(--spacing-6);
  margin-bottom: var(--spacing-8);
}

.brand-col p {
  color: rgba(255,255,255,0.7);
  margin-top: var(--spacing-2);
}

.social-links {
  display: flex;
  gap: var(--spacing-3);
  margin-top: var(--spacing-4);
}
.social-links a {
  color: #FFFFFF;
  font-size: 1.5rem;
  opacity: 0.7;
}
.social-links a:hover { opacity: 1; color: var(--color-accent); }

.footer h4 { color: #FFFFFF; margin-bottom: var(--spacing-4); }
.footer-links li { margin-bottom: var(--spacing-2); }
.footer-links a {
  color: rgba(255,255,255,0.7);
}
.footer-links a:hover {
  color: var(--color-accent);
}

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.1);
  padding-top: var(--spacing-4);
  text-align: center;
}
.disclosure {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.5);
  margin-bottom: var(--spacing-2);
}
.copyright {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.7);
}

/* ==========================================================================
   MODAL
   ========================================================================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(4px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: var(--transition);
}
.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.modal {
  background: var(--color-bg);
  border-radius: var(--radius);
  width: 90%;
  max-width: 500px;
  position: relative;
  transform: translateY(20px);
  transition: var(--transition);
  display: none;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}
.modal.active {
  display: block;
  transform: translateY(0);
}

.modal-close {
  position: absolute;
  top: var(--spacing-3);
  right: var(--spacing-3);
  background: none;
  border: none;
  font-size: 1.5rem;
  color: var(--color-text-muted);
  cursor: pointer;
  z-index: 10;
}
.modal-close:hover { color: var(--color-error); }

.modal-content { padding: var(--spacing-5); }
.modal-header { text-align: center; margin-bottom: var(--spacing-4); }
.modal-header .modal-icon {
  width: 64px;
  height: 64px;
  background: var(--color-bg-alt);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--spacing-3);
  font-size: 2rem;
  color: var(--color-accent);
}

.modal-body ul {
  list-style: disc;
  margin-left: var(--spacing-4);
  margin-bottom: var(--spacing-4);
  color: var(--color-text-muted);
}
.pricing-tier {
  background: var(--color-bg-alt);
  padding: var(--spacing-3);
  border-radius: var(--radius);
  text-align: center;
  margin-bottom: var(--spacing-4);
  border: 1px solid var(--color-border);
}
.pricing-tier span { display: block; font-size: 0.875rem; color: var(--color-text-muted); }
.pricing-tier strong { font-size: 1.25rem; color: var(--color-primary); }

/* ==========================================================================
   ANIMATIONS
   ========================================================================== */
.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform, opacity;
}
.reveal.active {
  opacity: 1;
  transform: translateY(0);
}

/* ==========================================================================
   MEDIA QUERIES
   ========================================================================== */

/* Desktop — full nav */
@media (min-width: 1025px) and (max-width: 1439px) {
  .hero h1 { font-size: 3.5rem; }
}

/* Tablet+Mobile — hamburger starts */
@media (max-width: 1024px) {
  .nav-menu {
    position: fixed;
    top: 0;
    right: -100%;
    width: 320px;
    height: 100vh;
    background: var(--color-bg);
    flex-direction: column;
    align-items: flex-start;
    padding: var(--spacing-8) var(--spacing-5);
    transition: var(--transition);
    box-shadow: -4px 0 15px rgba(0,0,0,0.1);
  }
  
  .nav-menu.active {
    right: 0;
  }
  
  .hamburger { display: block; }
  .drawer-close { display: block; }
  
  .nav-links {
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    margin-bottom: var(--spacing-5);
  }
  
  .nav-link {
    display: block;
    width: 100%;
    padding: var(--spacing-2) 0;
    font-size: 1.125rem;
    min-height: 44px;
  }
  
  .nav-actions {
    flex-direction: column;
    width: 100%;
    align-items: stretch;
  }
  
  .theme-toggle {
    margin-bottom: var(--spacing-4);
    align-self: flex-start;
  }
  
  .hero-content, .booking-wrapper, .resources-grid, .about-container {
    grid-template-columns: 1fr;
  }
  
  .trust-strip-inner {
    justify-content: center;
  }
  
  .articles-grid {
    grid-template-columns: 1fr;
  }
  
  .about-image { order: -1; }
}

/* Mobile */
@media (max-width: 768px) {
  .hero {
    padding-top: calc(var(--spacing-6) + var(--nav-height));
  }
  .form-row, .trust-features-grid, .contact-container {
    grid-template-columns: 1fr;
  }
  .footer-grid {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .footer-grid .logo { justify-content: center; }
  .social-links { justify-content: center; }
  .credibility-stats { flex-wrap: wrap; justify-content: center; text-align: center; }
}

/* Small Mobile */
@media (max-width: 360px) {
  .nav-menu { width: 100%; }
  .hero h1 { font-size: 2.25rem; }
  .hero-actions { flex-direction: column; }
  .btn { width: 100%; }
  
  /* Ensure no overflow in contact section */
  .contact-container { padding: 0; overflow-x: hidden; }
  .form { padding: var(--spacing-3); }
}
